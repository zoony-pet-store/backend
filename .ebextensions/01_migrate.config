container_commands:
  00_debug:
    command: "echo 'Current directory:' && pwd && echo 'Files in /var/app/current:' && ls -la /var/app/current/ && echo 'Python path:' && which python && echo 'Environment variables:' && env | sort"
  01_migrate:
    command: "python /var/app/current/manage.py migrate --noinput"
    leader_only: true
