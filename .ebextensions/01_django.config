option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: pet_store.settings
    PYTHONPATH: /app
    PYTHONUNBUFFERED: 1

  aws:elasticbeanstalk:container:python:
    WSGIPath: pet_store.wsgi:application

  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
