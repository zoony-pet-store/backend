# =====================
# DJANGO
# =====================

DJANGO_SECRET_KEY=local-development-secret-key
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1


# =====================
# LOCAL FRONTEND
# =====================

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173


# =====================
# LOCAL POSTGRESQL
# =====================

DB_NAME=zoony
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable


# =====================
# CLOUDINARY
# Optional for basic local development.
# Required when testing image uploads.
# =====================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# =====================
# EMAIL
# Optional for local development.
# =====================

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# =====================
# GOOGLE OAUTH2
# Optional unless Google authentication is being tested.
# =====================

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:8000/auth/complete/google-oauth2/
